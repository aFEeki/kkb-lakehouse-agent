# --- Never commit these. See README "Repo rules". ---
.claude/
**/.claude/
CLAUDE.local.md
.env
.env.*
!.env.example
*.key
secrets.*

# --- Data lake: too large for git, rebuilt by the ingest scripts ---
data/bronze/*
data/silver/*
data/gold/*
!data/**/.gitkeep
data/SNAPSHOT.md
*.parquet
*.duckdb
*.duckdb.wal
.lancedb/

# Release archives from scripts/package_snapshot.py. A snapshot is ~70 MB; it is
# distributed as a GitHub release asset, never committed.
dist/
*.tgz
*.tar.gz

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# --- Node / frontend ---
node_modules/
.next/
out/
.vercel/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local verification and runtime artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
*.tsbuildinfo
playwright-report/
test-results/
data/uploads/
