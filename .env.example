# Copy to .env

# MIA (Kloudeks)
MIA_API_KEY=API_KEYINIZ
MIA_BASE_URL=https://mia.csp.kloudeks.com/v1

MIA_CHAT_MODEL=kkbhackathon2026/Qwen3.8-27B
MIA_EMBED_MODEL=kkbhackathon2026/Qwen3-Embedding-8B
MIA_OCR_MODEL=kkbhackathon2026/Unlimited-OCR

# TCMB EVDS
EVDS_API_KEY=

# Local paths
DATA_DIR=./data
DUCKDB_PATH=./data/gold/lakehouse.duckdb
LANCEDB_PATH=./data/gold/.lancedb

# Self-hosted search (see PLAN.md — pending the compliance answer from KKB).
SEARXNG_URL=http://localhost:8888

# Browser origins permitted to read the local FastAPI health endpoint (JSON list).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
